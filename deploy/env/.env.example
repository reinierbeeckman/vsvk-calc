# Legacy fallback template.
# Prefer environment-specific templates:
# - deploy/env/.env.dev.example
# - deploy/env/.env.staging.example
# - deploy/env/.env.prod.example
#
# Copy the right template to deploy/env/.env on the target machine.
IMAGE_TAG=local
GITHUB_REPOSITORY_OWNER=local

PGDATABASE=vsvk_calc
PGUSER=vsvk
PGPASSWORD=change-me

KEYCLOAK_HOSTNAME=http://localhost:8081
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

OIDC_AUTHORITY=http://localhost:8081/realms/vsvk
OIDC_METADATA_ADDRESS=http://keycloak:8080/realms/vsvk/.well-known/openid-configuration
OIDC_CLIENT_ID=vsvk-bff
OIDC_CLIENT_SECRET=change-me
OIDC_CALLBACK_PATH=/signin-oidc

JWT_AUTHORITY=http://localhost:8081/realms/vsvk
JWT_METADATA_ADDRESS=http://keycloak:8080/realms/vsvk/.well-known/openid-configuration
JWT_AUDIENCE=vsvk-api
