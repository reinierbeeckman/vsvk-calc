# --- Common ---
# IMAGE_TAG is set by GitHub Actions during deploy.
IMAGE_TAG=local

# --- App PostgreSQL (staging/prod compose overlays) ---
PGDATABASE=vsvk_calc
PGUSER=vsvk
PGPASSWORD=change-me

# Alternatively, you can pass an explicit connection string (if you don't run postgres as a service)
# APPDB_CONNECTIONSTRING=Host=<host>;Port=5432;Database=vsvk_calc;Username=vsvk;Password=change-me

# --- Keycloak (issuer + admin) ---
# IMPORTANT: KEYCLOAK_HOSTNAME determines the issuer in tokens and must match OIDC_AUTHORITY/JWT_AUTHORITY.
KEYCLOAK_HOSTNAME=https://auth.example.com
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Keycloak PostgreSQL (separate DB + creds)
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

# --- OIDC (BFF) ---
OIDC_AUTHORITY=https://auth.example.com/realms/vsvk
# Metadata can be fetched internally (container hostname) if needed
OIDC_METADATA_ADDRESS=http://keycloak:8080/realms/vsvk/.well-known/openid-configuration
OIDC_CLIENT_ID=vsvk-bff
OIDC_CLIENT_SECRET=change-me
OIDC_CALLBACK_PATH=/signin-oidc

# --- JWT (API) ---
JWT_AUTHORITY=https://auth.example.com/realms/vsvk
JWT_METADATA_ADDRESS=http://keycloak:8080/realms/vsvk/.well-known/openid-configuration
JWT_AUDIENCE=vsvk-api
