{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "DataProtection": {
    "KeysPath": "/var/lib/vsvk-bff/keys"
  },

  "Oidc": {
    "Authority": "",
    "MetadataAddress": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc"
  },

  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api1": {
            "Address": "http://api:8090/"
          }
        }
      }
    }
  }
}
